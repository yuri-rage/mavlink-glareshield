{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "main.ts",
    "preload.ts",
    "udpVehicles.ts",
    "ntripClient.ts",
    "ntripStreams.ts",
    "settings.ts",
    "bridgeCert.ts",
    "bridgeServer.ts"
  ]
}
