{
  "version": "1.0.0",
  "name": "Mission Planner style",
  "updatedAt": "2026-11-25T00:00:00.000Z",
  "customWidgets": [
    {
      "id": "custom-mp-vitals",
      "name": "Vitals",
      "description": "What needs attention at a glance: battery, power, GNSS quality, link loss and autopilot load, with vibration and EKF health. Values turn amber or red past their limits.",
      "category": "telemetry",
      "displayType": "composite",
      "colorScheme": "default",
      "panels": [
        {
          "displayType": "stat-card",
          "title": "Battery",
          "span": 4,
          "colorScheme": "green",
          "binding": {
            "messageName": "SYS_STATUS",
            "fieldName": "battery_remaining",
            "unit": "%",
            "decimals": 0,
            "min": 0,
            "max": 100,
            "warnThreshold": 30,
            "critThreshold": 15,
            "thresholdInvert": true
          }
        },
        {
          "displayType": "stat-card",
          "title": "Voltage",
          "span": 4,
          "colorScheme": "amber",
          "binding": {
            "messageName": "SYS_STATUS",
            "fieldName": "voltage_battery",
            "unit": "V",
            "decimals": 2
          }
        },
        {
          "displayType": "stat-card",
          "title": "Current",
          "span": 4,
          "colorScheme": "amber",
          "binding": {
            "messageName": "SYS_STATUS",
            "fieldName": "current_battery",
            "unit": "A",
            "decimals": 1
          }
        },
        {
          "displayType": "stat-card",
          "title": "GNSS HDOP",
          "span": 4,
          "colorScheme": "blue",
          "binding": {
            "messageName": "GPS_RAW_INT",
            "fieldName": "eph",
            "unit": "",
            "decimals": 2,
            "warnThreshold": 1.4,
            "critThreshold": 2.0
          }
        },
        {
          "displayType": "stat-card",
          "title": "Link Loss",
          "span": 4,
          "colorScheme": "blue",
          "binding": {
            "messageName": "SYS_STATUS",
            "fieldName": "drop_rate_comm",
            "unit": "%",
            "decimals": 1,
            "multiplier": 0.01,
            "warnThreshold": 5,
            "critThreshold": 15
          }
        },
        {
          "displayType": "stat-card",
          "title": "CPU Load",
          "span": 4,
          "colorScheme": "default",
          "binding": {
            "messageName": "SYS_STATUS",
            "fieldName": "load",
            "unit": "%",
            "decimals": 0,
            "warnThreshold": 80,
            "critThreshold": 95
          }
        },
        {
          "displayType": "multi-bar",
          "title": "Vibration",
          "span": 6,
          "multiBarConfig": {
            "group": "vibration-xyz"
          }
        },
        {
          "displayType": "multi-bar",
          "title": "EKF variances",
          "span": 6,
          "multiBarConfig": {
            "group": "ekf-variances"
          }
        }
      ]
    },
    {
      "id": "custom-mp-track",
      "name": "Track Error",
      "description": "How far off its path the vehicle is in Auto and Guided: cross-track error (all vehicles) and altitude error (aircraft). Flat at zero otherwise.",
      "category": "telemetry",
      "displayType": "sparkline",
      "colorScheme": "blue",
      "binding": {
        "messageName": "NAV_CONTROLLER_OUTPUT",
        "fieldName": "xtrack_error",
        "unit": "m",
        "decimals": 1,
        "unitKind": "distance",
        "label": "Cross-track",
        "color": "#38bdf8"
      },
      "bindings": [
        {
          "messageName": "NAV_CONTROLLER_OUTPUT",
          "fieldName": "alt_error",
          "unit": "m",
          "decimals": 1,
          "unitKind": "altitude",
          "label": "Altitude",
          "color": "#f59e0b"
        }
      ]
    },
    {
      "id": "custom-mp-attitude",
      "name": "Attitude Tuning",
      "description": "The rate and angle controllers' gains: Copter and Rover ATC_*, Plane RLL_ / PTCH_ / YAW_RATE_*. Only the vehicle's own are listed.",
      "category": "control",
      "displayType": "param-set",
      "colorScheme": "blue",
      "paramSet": {
        "params": [
          "ATC_RAT_RLL_*",
          "ATC_RAT_PIT_*",
          "ATC_RAT_YAW_*",
          "ATC_ANG_*",
          "ATC_ACCEL_*",
          "RLL_RATE_*",
          "PTCH_RATE_*",
          "YAW_RATE_*",
          "-*_SMAX",
          "-*_PDMX",
          "-*_NTF",
          "-*_NEF",
          "-*_FLT?",
          "-*_D_FF"
        ],
        "confirmation": true
      }
    },
    {
      "id": "custom-mp-navigation",
      "name": "Navigation",
      "description": "How it flies between waypoints: Copter WPNAV_*, LOIT_* and position controller gains; Plane NAVL1_*, TECS speed and height limits, WP_* and airspeeds.",
      "category": "control",
      "displayType": "param-set",
      "colorScheme": "green",
      "paramSet": {
        "params": [
          "WPNAV_*",
          "LOIT_SPEED*",
          "LOIT_ACC_MAX*",
          "PSC_POSXY_P*",
          "PSC_VELXY_*",
          "PSC_POSZ_P*",
          "PSC_VELZ_P*",
          "NAVL1_*",
          "WP_*",
          "TECS_CLMB_MAX*",
          "TECS_SINK_*",
          "TECS_TIME_CONST*",
          "TECS_SPDWEIGHT*",
          "TECS_PITCH_M*",
          "AIRSPEED_CRUISE*",
          "AIRSPEED_MIN*",
          "AIRSPEED_MAX*",
          "-*_SMAX",
          "-*_PDMX",
          "-*_NTF",
          "-*_NEF",
          "-*_FLT?",
          "-*_D_FF"
        ],
        "confirmation": true
      }
    },
    {
      "id": "custom-mp-failsafes",
      "name": "Failsafes & RTL",
      "description": "What it does when something goes wrong: battery, radio and GCS failsafes, and the return home.",
      "category": "control",
      "displayType": "param-set",
      "colorScheme": "red",
      "paramSet": {
        "params": [
          "FS_*",
          "BATT_FS_*",
          "BATT_LOW_*",
          "BATT_CRT_*",
          "THR_FS*",
          "RTL_*",
          "FENCE_ENABLE*",
          "FENCE_ACTION*"
        ],
        "confirmation": true
      }
    }
  ],
