{
  "version": "1.0.0",
  "name": "Mission Planner style",
  "updatedAt": "2026-11-25T00:00:00.000Z",
  "customWidgets": [
    {
      "id": "custom-mp-vitals",
      "name": "Vitals",
      "description": "What needs attention at a glance: throttle, vibration and EKF health, battery and GNSS quality (HDOP). Values turn amber or red past their limits.",
      "category": "telemetry",
      "displayType": "composite",
      "colorScheme": "default",
      "panels": [
        {
          "displayType": "gauge-radial",
          "title": "Throttle",
          "span": 4,
          "colorScheme": "amber",
          "binding": {
            "messageName": "VFR_HUD",
            "fieldName": "throttle",
            "unit": "%",
            "decimals": 0,
            "min": 0,
            "max": 100
          },
          "gauge": {
            "sweep": 240,
            "style": "arc",
            "majorTicks": 5,
            "minorTicks": 4
          }
        },
        {
          "displayType": "multi-bar",
          "title": "Vibration",
          "span": 4,
          "multiBarConfig": {
            "group": "vibration-xyz"
          }
        },
        {
          "displayType": "multi-bar",
          "title": "EKF variances",
          "span": 4,
          "multiBarConfig": {
            "group": "ekf-variances"
          }
        },
        {
          "displayType": "stat-card",
          "title": "Battery",
          "span": 6,
          "colorScheme": "green",
          "binding": {
            "messageName": "SYS_STATUS",
            "fieldName": "battery_remaining",
            "unit": "%",
            "decimals": 0,
            "min": 0,
            "max": 100,
            "warnThreshold": 30,
            "critThreshold": 15,
            "thresholdInvert": true
          }
        },
        {
          "displayType": "stat-card",
          "title": "GNSS HDOP",
          "span": 6,
          "colorScheme": "blue",
          "binding": {
            "messageName": "GPS_RAW_INT",
            "fieldName": "eph",
            "decimals": 2,
            "warnThreshold": 1.4,
            "critThreshold": 2.0
          }
        }
      ]
    },
    {
      "id": "custom-mp-altitude",
      "name": "Altitude",
      "description": "Altitude above home over the last minute or so.",
      "category": "telemetry",
      "displayType": "sparkline",
      "colorScheme": "amber",
      "binding": {
        "messageName": "GLOBAL_POSITION_INT",
        "fieldName": "relative_alt",
        "unit": "m",
        "decimals": 1,
        "unitKind": "altitude"
      }
    }
  ],
