{
  "name": "mavlink-glareshield",
  "private": true,
  "version": "0.1.0",
  "description": "Glareshield: ArduPilot ground control (web app and desktop app)",
  "author": "Yuri Rage",
  "homepage": "https://glareshield.yurirage.com/",
  "main": "desktop/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:widgets": "tsx tests/widgets.test.ts",
    "test:transport": "tsx tests/transport.test.ts",
    "test:golden": "tsx tests/golden.test.ts",
    "test:vectors": "python3 tests/gen_vectors.py",
    "test:mock": "python3 tests/check_mock_bridge.py",
    "test:ftp-sim": "tsx tests/ftp_ardupilot.test.ts",
    "test:regressions": "tsx tests/regressions.test.ts",
    "test:bridge-security": "python3 tests/check_bridge_security.py",
    "test:bridge-udp": "python3 tests/check_bridge_udp_target.py",
    "test:bridge-transport": "python3 tests/check_bridge_transport.py",
    "test:bridge-pairing": "python3 tests/check_bridge_pairing.py",
    "test:follow": "python3 tests/follow_sim.py",
    "test:review": "npm run test:mock && npm run test:bridge-security && npm run test:bridge-udp && npm run test:bridge-transport && npm run test:bridge-pairing && npm run test:follow",
    "format": "prettier --write . && ruff format && ruff check --fix",
    "format:check": "prettier --check . && ruff format --check && ruff check",
    "desktop:compile": "tsc -p desktop --noEmit && esbuild desktop/main.ts --bundle --platform=node --format=cjs --external:electron --external:@serialport/bindings-cpp --outfile=desktop/dist/main.js --log-level=warning && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop/dist/preload.js --log-level=warning",
    "desktop": "npm run build && npm run desktop:compile && electron .",
    "desktop:dist": "npm run build && npm run desktop:compile && electron-builder --publish never"
  },
  "dependencies": {
    "@serialport/bindings-cpp": "13.0.1"
  },
  "devDependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/container-queries": "0.1.1",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "onnxruntime-web": "1.18.0",
    "postcss": "^8.4.49",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "4.21.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "uqr": "0.1.3",
    "vite": "^6.4.5",
    "zustand": "^4.5.5"
  },
  "desktopName": "glareshield.desktop"
}
