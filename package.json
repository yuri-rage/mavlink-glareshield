{
  "name": "mavlink-glareshield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npx tsx tests/mavlink.test.ts && npx tsx tests/golden.test.ts && npx tsx tests/transport.test.ts && npx tsx tests/widgets.test.ts",
    "test:widgets": "npx tsx tests/widgets.test.ts",
    "test:transport": "npx tsx tests/transport.test.ts",
    "test:golden": "npx tsx tests/golden.test.ts",
    "test:vectors": "python3 tests/gen_vectors.py",
    "test:mock": "python3 tests/check_mock_bridge.py",
    "test:ftp-sim": "npx tsx tests/ftp_ardupilot.test.ts",
    "test:regressions": "npx tsx tests/regressions.test.ts",
    "test:bridge-security": "python3 tests/check_bridge_security.py",
    "test:bridge-udp": "python3 tests/check_bridge_udp_target.py",
    "test:review": "npm run test:ftp-sim && npm run test:regressions && npm run test:bridge-security && npm run test:bridge-udp"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
